<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash mark, shared by the pre-Android-12 window background and the
    Android 12+ splash screen icon. A vector rather than the PNG set
    flutter_native_splash would generate: the repository's .gitignore ignores
    *.png, so those bitmaps could never be committed, which is how
    @drawable/background and @drawable/splash came to be referenced by
    launch_background.xml without existing in the tree.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26 C54,26 74,50 74,63 A20,20 0 0,1 34,63 C34,50 54,26 54,26 Z" />
    <path
        android:fillColor="#99D4E8FF"
        android:pathData="M46,58 A8,8 0 1,0 46,74 A12,12 0 0,1 46,58 Z" />
</vector>
